ARG BASE_IMAGE=bitbots-base:latest
FROM ${BASE_IMAGE}

ARG user=bitbots
USER $user
WORKDIR /home/$user/bitbots_main

# Setup SSH key for bitbots user
ARG ssh_pub_key
RUN mkdir -p /home/${user}/.ssh \
  && if [ -n "$ssh_pub_key" ]; then echo "${ssh_pub_key}" > /home/${user}/.ssh/authorized_keys; fi \
  && chown -R ${user}:${user} /home/${user}/.ssh \
  && chmod 700 /home/${user}/.ssh \
  && if [ -f /home/${user}/.ssh/authorized_keys ]; then chmod 600 /home/${user}/.ssh/authorized_keys; fi

USER root
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER $user
# Copy project files (respecting .dockerignore if present in context)
COPY --chown=$user:$user . .

# Install dependencies and build workspace
# This will take a while and produce a large image as requested.
RUN /home/$user/.pixi/bin/pixi run --environment default build

RUN mkdir -p /home/${user}/zenoh_test
WORKDIR /home/${user}/zenoh_test
RUN /home/$user/.pixi/bin/pixi init
RUN /home/$user/.pixi/bin/pixi add python
RUN /home/$user/.pixi/bin/pixi add --pypi zenoh-cli

# Switch back to root
USER root
EXPOSE 22
EXPOSE 8080

WORKDIR /home/${user}/bitbots_main

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["default"]
