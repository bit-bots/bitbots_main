<?xml version="1.0" encoding="utf-8" ?>
<launch>
    <arg name="sim" default="false"
         description="true: activates simulation time" />
    <arg name="debug" default="false"
         description="true: activates publishing of the debug image" />
    <arg name="vision_backend" default="original" description="Vision backend: original or schnupper" />

    <include file="$(find-pkg-share bitbots_vision)/launch/vision_backend.launch.py">
        <arg name="vision_backend" value="$(var vision_backend)" />
        <arg name="sim" value="$(var sim)" />
        <arg name="debug" value="$(var debug)" />
    </include>
</launch>
