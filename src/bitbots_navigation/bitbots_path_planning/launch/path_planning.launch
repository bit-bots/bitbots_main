<launch>
    <arg name="sim" default="false" description="true: activates simulation time" />
    <arg name="obstacle_map" default="false" description="true: also publish a static obstacle map from a yaml file" />
    <arg name="obstacle_map_file" default="$(find-pkg-share bitbots_path_planning)/config/obstacle_map_example.yaml" description="yaml file with the static box/cylinder obstacles" />

    <node pkg="bitbots_path_planning" exec="path_planning" name="bitbots_path_planning" output="screen">
        <param name="use_sim_time" value="$(var sim)"/>
        <param from="$(find-pkg-share bitbots_path_planning)/config/path_planning_parameters_$(env ROBOT_NAME default).yaml"/>
    </node>

    <group if="$(var obstacle_map)">
        <node pkg="bitbots_path_planning" exec="obstacle_map" name="obstacle_map" output="screen">
            <param name="use_sim_time" value="$(var sim)"/>
            <param name="obstacle_map_path" value="$(var obstacle_map_file)"/>
        </node>
    </group>
</launch>
