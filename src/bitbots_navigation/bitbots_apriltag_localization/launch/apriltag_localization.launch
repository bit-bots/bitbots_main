<launch>
  <arg name="sim" default="false"/>

  <node pkg="bitbots_apriltag_localization" exec="localization_node" output="screen">
    <param from="$(find-pkg-share bitbots_apriltag_localization)/config/apriltag_localization.yaml" />
    <param name="use_sim_time" value="$(var sim)"/>
  </node>
</launch>
