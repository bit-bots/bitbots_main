<launch>
    <arg name="dsd_file" default="main.dsd" />
    <arg name="behavior_mode" default="simple" />
    <arg name="simple_behavior_script" default="" />
    <arg name="tf_prefix" default=""/>
    <arg name="sim" default="false" />


    <node pkg="bitbots_body_behavior" exec="body_behavior" output="screen" respawn="true" unless="$(eval '\'$(var behavior_mode)\' == \'simple_web\'')">
        <param from="$(find-pkg-share bitbots_body_behavior)/config/body_behavior.yaml"/>
        <param from="$(find-pkg-share bitbots_body_behavior)/config/animations.yaml"/>
        <param name="dsd_file" value="$(var dsd_file)"/>
        <param name="behavior_mode" value="$(var behavior_mode)"/>
        <param name="simple_behavior_script" value="$(var simple_behavior_script)"/>
        <param name="odom_frame" value="$(var tf_prefix)odom"/>
        <param name="map_frame" value="$(var tf_prefix)map"/>
        <param name="base_footprint_frame" value="$(var tf_prefix)base_footprint"/>
        <param name="use_sim_time" value="$(var sim)" />
    </node>

    <node pkg="bitbots_body_behavior" exec="simple_behavior_web_wrapper" output="screen" respawn="true" if="$(eval '\'$(var behavior_mode)\' == \'simple_web\'')">
        <param from="$(find-pkg-share bitbots_body_behavior)/config/body_behavior.yaml"/>
        <param name="use_sim_time" value="$(var sim)" />
    </node>
</launch>
