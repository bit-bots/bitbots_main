<launch>
  <arg name="sim" default="false"/>
  <arg name="walk" default="true"/>
  <arg name="kick" default="false"/>
  <arg name="mjlab_walk" default="false"/>
  <arg name="cartwheel" default="true"/>
  <arg name="mjlab_getup" default="false"/>
  <arg name="beyondmimic_standup" default="true"/>


  <group if="$(var walk)">
    <node pkg="bitbots_rl_motion" exec="walk_node" output="screen">
      <param from="$(find-pkg-share bitbots_rl_motion)/configs/playground_walk_model.yaml" />
      <param name="use_sim_time" value="$(var sim)"/>
    </node>
  </group>

  <group if="$(var kick)">
    <node pkg="bitbots_rl_motion" exec="kick_node" output="screen">
      <param from="$(find-pkg-share bitbots_rl_motion)/configs/wolfgang_dribbling_model_config.yaml" />
      <param name="use_sim_time" value="$(var sim)"/>
    </node>
  </group>
  <group if="$(var mjlab_walk)">
    <node pkg="bitbots_rl_motion" exec="mjlab_walk_node" output="screen">
      <param from="$(find-pkg-share bitbots_rl_motion)/configs/mjlab_walk_model.yaml" />
      <param name="use_sim_time" value="$(var sim)"/>
    </node>
  </group>
  <group if="$(var mjlab_getup)">
    <node pkg="bitbots_rl_motion" exec="mjlab_getup_node" output="screen">
      <param from="$(find-pkg-share bitbots_rl_motion)/configs/mjlab_getup_model.yaml" />
      <param name="use_sim_time" value="$(var sim)"/>
    </node>
  </group>
  <group if="$(var cartwheel)">
    <node pkg="bitbots_rl_motion" exec="cartwheel_rl_node" output="screen">
      <param from="$(find-pkg-share bitbots_rl_motion)/configs/cartwheel_model.yaml" />
    </node>
  </group>
  <group if="$(var beyondmimic_standup)">
    <node pkg="bitbots_rl_motion" exec="beyondmimic_standup_node" output="screen">
      <param from="$(find-pkg-share bitbots_rl_motion)/configs/beyondmimic_standup_model.yaml" />
      <param name="use_sim_time" value="$(var sim)"/>
    </node>
  </group>
</launch>
