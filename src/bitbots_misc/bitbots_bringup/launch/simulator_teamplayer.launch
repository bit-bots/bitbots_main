<?xml version="1.0"?>
<launch>
    <arg name="vision_backend" default="schnupper" description="Vision backend: original or schnupper" />
    <arg name="vision_debug" default="false" description="Publish vision debug overlays" />
    <arg name="audio" default="false" description="Whether the audio system should be started" />
    <arg name="behavior" default="true" description="Whether the behavior control system should be started" />
    <arg name="behavior_dsd_file" default="main.dsd" description="The behavior dsd file that should be used" />
    <arg name="behavior_mode" default="dsd" description="The body behavior implementation that should be used" />
    <arg name="simple_behavior_script" default="" description="The script used by simple behavior mode" />
    <arg name="simple_behavior_web_host" default="127.0.0.1" description="The host used by simple web behavior mode" />
    <arg name="simple_behavior_web_port" default="0" description="The port used by simple web behavior mode" />
    <arg name="game_controller" default="true" description="Whether the Gamecontroller module should be started" />
    <arg name="ipm" default="true" description="Whether the inverse perspective mapping should be started"/>
    <arg name="localization" default="true" description="Whether the localization system should be started" />
    <arg name="fake_localization" default="true" description="Whether to fake the localization with the ground truth of the simulator if the localization system is not started" />
    <arg name="motion" default="true" description="Whether the motion control system should be started" />
    <arg name="path_planning" default="true" description="Whether the path planning should be started"/>
    <arg name="teamcom" default="false" description="Whether the team communication system should be started" />
    <arg name="vision" default="true" description="Whether the vision system should be started" />
    <arg name="world_model" default="true" description="Whether the world model should be started"/>
    <arg name="rl_motion" default="true" description="Whether to use the RL motion system instead of the regular one" />
    <arg name="web" default="true" description="Use web-based mjviser viewer instead of the native MuJoCo viewer"/>

    <arg name="ball_style" default="orange" description="Ball appearance: original or orange" />

    <!-- load the general simulator -->
    <include file="$(find-pkg-share bitbots_mujoco_sim)/launch/simulator.launch" >
        <arg name="web" value="$(var web)" />
        <arg name="ball_style" value="$(var ball_style)" />
    </include>

    <!-- load teamplayer software stack -->
    <include file="$(find-pkg-share bitbots_bringup)/launch/teamplayer.launch">
        <arg name="vision_backend" value="$(var vision_backend)" />
        <arg name="vision_debug" value="$(var vision_debug)" />
        <arg name="audio" value="$(var audio)" />
        <arg name="behavior" value="$(var behavior)" />
        <arg name="behavior_dsd_file" value="$(var behavior_dsd_file)" />
        <arg name="behavior_mode" value="$(var behavior_mode)" />
        <arg name="simple_behavior_script" value="$(var simple_behavior_script)" />
        <arg name="simple_behavior_web_host" value="$(var simple_behavior_web_host)" />
        <arg name="simple_behavior_web_port" value="$(var simple_behavior_web_port)" />
        <arg name="game_controller" value="$(var game_controller)"/>
        <arg name="ipm" value="$(var ipm)" />
        <arg name="localization" value="$(var localization)" />
        <arg name="fake_localization" value="$(var fake_localization)" />
        <arg name="motion" value="$(var motion)" />
        <arg name="sim" value="true" />
        <arg name="path_planning" value="$(var path_planning)" />
        <arg name="teamcom" value="$(var teamcom)" />
        <arg name="vision" value="$(var vision)"/>
        <arg name="world_model" value="$(var world_model)"/>
        <arg name="rl_motion" value="$(var rl_motion)"/>
    </include>
</launch>
